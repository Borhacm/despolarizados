# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — solo con INGEST_CLUSTER_MODE=openai (por defecto: léxico, sin API)
OPENAI_API_KEY=

# Opcional: openai para embeddings. Sin esta línea o con lexical = solo RSS + léxico.
# INGEST_CLUSTER_MODE=openai
# Umbral 0–1 para modo léxico (opcional)
# INGEST_LEXICAL_THRESHOLD=0.36

# Protege /api/cron/ingest y el formulario /admin/medios (opcional: solo CRON_SECRET)
CRON_SECRET=
# Opcional: si lo pones, también sirve para /admin/medios (si no, se usa CRON_SECRET)
ADMIN_SECRET=
