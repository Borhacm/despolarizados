# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — solo con INGEST_CLUSTER_MODE=openai (por defecto: léxico, sin API)
OPENAI_API_KEY=

# Opcional: openai para embeddings. Sin esta línea o con lexical = solo RSS + léxico.
# INGEST_CLUSTER_MODE=openai
# Umbral 0–1 para modo léxico (opcional)
# INGEST_LEXICAL_THRESHOLD=0.36

# URL pública de la app (enlaces en correos del boletín). En Vercel suele bastar VERCEL_URL.
# NEXT_PUBLIC_APP_URL=https://tudominio.com

# Resend (https://resend.com) — verificación de suscripción y resúmenes por correo
# RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Despolarizados <boletin@tudominio.com>"
# NEWSLETTER_FROM_EMAIL=

# Protege /api/cron/ingest, /api/cron/newsletter-digest y los formularios bajo /admin/* (opcional: solo CRON_SECRET)
# Panel web no enlazado en la UI: /acceso-interno (atajo en la app: Alt+Shift+A)
CRON_SECRET=
# Opcional: si lo pones, también sirve para /admin/medios (si no, se usa CRON_SECRET)
ADMIN_SECRET=
